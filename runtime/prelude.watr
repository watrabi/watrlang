// The watrlang runtime. It's compiled into every program, and only the
// functions a program actually uses end up in its binary.
//
// Names start with __rt_ so they can't clash with yours. The compiler
// rewrites `echo`, string interpolation, `.` and string comparisons into
// calls to these functions.

// Provided by the compiler as small assembly routines.
extern function __rt_out(const u8* p, usize n): void;      // write to stdout
extern function __rt_mmap(usize n): u8*;                   // zeroed pages
extern function __rt_out_of_memory(): void;                // panics
extern function __rt_panic(string msg): void;              // prints msg, exits with 101
extern function __rt_exit(int code): void;                // ends the process (flushing stdio if linked)
extern function __rt_fmt_f64(f64 x, u8* buf): usize;       // "%.14g"; links libc
extern function __rt_zero(u8* p, usize n): void;           // rep stosb
extern function __rt_stack_pointer(): u64;                 // the caller's rsp
extern function __rt_save_regs(u64* buf): void;            // rbx, rbp, r12-r15
extern function __rt_gc_roots(): u64*;                     // [n, addr, size, addr, size, ...]

// ---- memory: a mark-and-sweep garbage collector -------------------------
//
// Objects live in chunks of memory from mmap. Each has a 16-byte header
// before it: its size (a multiple of 16) with flags in the low bits. A
// bitmap per chunk marks where objects start, so a pointer into the middle
// of an object (like a string slice) keeps the whole object alive.
//
// Roots are found conservatively: every word on the stack, in the saved
// callee-saved registers, in globals that can hold pointers (a table the
// compiler emits), and in `alloc` memory. Anything that looks like a
// pointer into an object counts. Objects are scanned the same way, except
// string bytes, which can't hold pointers.
//
// `alloc` memory is in the same heap but is never collected: `free`
// releases it.

const u64 __GC_MARK = 1;
const u64 __GC_MANUAL = 2;    // from alloc: a root, freed only by free()
const u64 __GC_FREE = 4;      // a free block, not an object
const u64 __GC_NOSCAN = 8;    // holds no pointers (string bytes)
const usize __GC_CHUNK = 1048576;
const usize __GC_LARGE = 262144;   // bigger objects get a chunk of their own
const usize __GC_SMALL = 1024;     // sizes up to this have exact-size free lists

struct __RtChunk {
    u8* base;        // the mapping; starts with the bitmap
    u8* start;       // first object header
    u8* bump;        // end of the used part
    u8* limit;       // end of the mapping
}

__RtChunk* __gc_chunks;
usize __gc_nchunks;
usize __gc_chunks_cap;
usize __gc_cur;                // the chunk small objects are bumped from, plus one (0: none)
u64 __gc_lo;                   // the address range of all chunks
u64 __gc_hi;
u8*[65] __gc_free;             // free lists by size / 16; [0] holds bigger blocks
usize __gc_since;              // bytes allocated since the last collection
usize __gc_threshold = 4194304;
usize __gc_live;               // bytes that survived the last collection
usize __gc_heap;               // bytes mapped
usize __gc_collections;
u64[6] __gc_regs;
u64* __gc_stack;               // mark stack
usize __gc_stack_len;
usize __gc_stack_cap;
u64 __rt_stack_base;           // set by the entry code before main runs
u64 __rt_argc;                 // the command line, also set by the entry code (std/os)
u8** __rt_argv;
u8** __rt_envp;                // the environment: NAME=value strings, then null
bool __rt_gc_stress;           // collect at every allocation (watrc reads WATR_GC_STRESS)

function __gc_bit(__RtChunk* c, u8* h): u64* {
    usize g = (h - c->base) as usize >> 4;
    return (c->base as u64*) + (g >> 6);
}

function __gc_set_bit(__RtChunk* c, u8* h): void {
    usize g = (h - c->base) as usize >> 4;
    *__gc_bit(c, h) |= 1 << (g & 63);
}

function __gc_clear_bit(__RtChunk* c, u8* h): void {
    usize g = (h - c->base) as usize >> 4;
    *__gc_bit(c, h) &= ~(1 << (g & 63));
}

function __gc_chunk_of(u64 a): __RtChunk* {
    if (a < __gc_lo || a >= __gc_hi) {
        return null;
    }
    for (usize i = 0; i < __gc_nchunks; i++) {
        __RtChunk* c = __gc_chunks + i;
        if (a >= c->start as u64 && a < c->bump as u64) {
            return c;
        }
    }
    return null;
}

// The header of the object containing address a, or null.
function __gc_find(u64 a): u8* {
    __RtChunk* c = __gc_chunk_of(a);
    if (c == null) {
        return null;
    }
    u64* bits = c->base as u64*;
    usize g = (a - c->base as u64) >> 4;
    usize w = g >> 6;
    u64 word = bits[w] & (~0 >> (63 - (g & 63)));   // bits at or below g
    while (word == 0) {
        if (w == 0) {
            return null;
        }
        w--;
        word = bits[w];
    }
    usize top = 63;
    while ((word >> top) == 0) {
        top--;
    }
    u8* h = c->base + ((w << 6) + top) * 16;
    u64 head = *(h as u64*);
    if ((head & __GC_FREE) != 0 || a >= h as u64 + 16 + (head & ~15)) {
        return null;
    }
    return h;
}

function __gc_grow_chunks(): void {
    usize cap = __gc_chunks_cap == 0 ? 64 : __gc_chunks_cap * 2;
    __RtChunk* fresh = __rt_mmap(cap * sizeof(__RtChunk)) as __RtChunk*;
    if (fresh as u64 > 18446744073709547520) {   // mmap returned -errno
        __rt_out_of_memory();
    }
    for (usize i = 0; i < __gc_nchunks; i++) {
        fresh[i] = __gc_chunks[i];
    }
    __gc_chunks = fresh;   // the old table is small; it's left mapped
    __gc_chunks_cap = cap;
}

// A chunk with room for an object of `need` bytes.
function __gc_new_chunk(usize need): __RtChunk* {
    usize size = __GC_CHUNK;
    if (need + 16 + 4096 > size - size / 128) {
        size = ((need + 16) * 128 / 127 + 8192 + 4095) & ~4095;
    }
    u8* base = __rt_mmap(size);
    if (base as u64 > 18446744073709547520) {
        __rt_out_of_memory();
    }
    if (__gc_nchunks == __gc_chunks_cap) {
        __gc_grow_chunks();
    }
    __RtChunk* c = __gc_chunks + __gc_nchunks;
    __gc_nchunks++;
    usize bitmap = (size / 128 + 15) & ~15;
    c->base = base;
    c->start = base + bitmap;
    c->bump = c->start;
    c->limit = base + size;
    if (__gc_lo == 0 || base as u64 < __gc_lo) {
        __gc_lo = base as u64;
    }
    if (c->limit as u64 > __gc_hi) {
        __gc_hi = c->limit as u64;
    }
    __gc_heap += size;
    return c;
}

function __gc_list_of(usize size): usize {
    return size <= __GC_SMALL ? size / 16 : 0;
}

function __gc_push_free(u8* h, usize size): void {
    *(h as u64*) = size | __GC_FREE;
    usize i = __gc_list_of(size);
    *((h + 16) as u8**) = __gc_free[i];
    __gc_free[i] = h;
}

// A free block of at least n bytes, taken off its list, or null.
function __gc_take_free(usize n): u8* {
    usize i = __gc_list_of(n);
    if (i != 0 && __gc_free[i] != null) {
        u8* h = __gc_free[i];
        __gc_free[i] = *((h + 16) as u8**);
        return h;
    }
    u8** link = &__gc_free[0];
    while (*link != null) {
        u8* h = *link;
        usize size = *(h as u64*) & ~15;
        if (size >= n) {
            *link = *((h + 16) as u8**);
            if (size - n >= 32) {   // split off the rest
                u8* rest = h + 16 + n;
                __gc_set_bit(__gc_chunk_of(h as u64), rest);
                __gc_push_free(rest, size - n - 16);
                *(h as u64*) = n;
            }
            return h;
        }
        link = (h + 16) as u8**;
    }
    return null;
}

function __gc_bump(usize n): u8* {
    if (n > __GC_LARGE) {
        __RtChunk* big = __gc_new_chunk(n);
        u8* h = big->bump;
        big->bump += 16 + n;
        __gc_set_bit(big, h);
        return h;
    }
    if (__gc_cur == 0 || (__gc_chunks[__gc_cur - 1]->limit - __gc_chunks[__gc_cur - 1]->bump) as usize < 16 + n) {
        __gc_new_chunk(n);
        __gc_cur = __gc_nchunks;
    }
    __RtChunk* c = __gc_chunks + (__gc_cur - 1);
    u8* h = c->bump;
    c->bump += 16 + n;
    __gc_set_bit(c, h);
    return h;
}

function __gc_alloc(usize n, u64 flags): u8* {
    if (n > 70368744177664) {   // 64 TiB: certainly a size computation that overflowed
        __rt_out_of_memory();
    }
    n = n == 0 ? 16 : (n + 15) & ~15;
    if (__rt_gc_stress || __gc_since >= __gc_threshold) {
        __rt_gc_collect();
    }
    u8* h = __gc_take_free(n);
    if (h == null) {
        h = __gc_bump(n);
        *(h as u64*) = n;
    }
    usize size = *(h as u64*) & ~15;
    *(h as u64*) = size | flags;
    __rt_zero(h + 16, size);
    __gc_since += size + 16;
    return h + 16;
}

// Memory for objects (scanned for pointers).
function __rt_alloc(usize n): u8* {
    return __gc_alloc(n, 0);
}

// Memory for bytes that never hold pointers, like string contents.
function __rt_alloc_bytes(usize n): u8* {
    return __gc_alloc(n, __GC_NOSCAN);
}

// alloc(T, count): zeroed, never collected, released by free().
function __rt_alloc_manual(usize count, usize size): u8* {
    if (size != 0 && count > 18446744073709551615 / size) {
        __rt_panic("panic: alloc size overflows\n");
    }
    return __gc_alloc(count * size, __GC_MANUAL);
}

function __rt_free(u8* p): void {
    if (p == null) {
        return;
    }
    u8* h = __gc_find(p as u64);
    if (h == null || h + 16 != p || (*(h as u64*) & __GC_MANUAL) == 0) {
        __rt_panic("panic: free() of a pointer that alloc() didn't return, or that was already freed\n");
    }
    usize size = *(h as u64*) & ~15;
    __gc_push_free(h, size);
}

// ---- collection ---------------------------------------------------------------

function __gc_push(u8* h): void {
    if (__gc_stack_len == __gc_stack_cap) {
        usize cap = __gc_stack_cap == 0 ? 4096 : __gc_stack_cap * 2;
        u64* fresh = __rt_mmap(cap * 8) as u64*;
        if (fresh as u64 > 18446744073709547520) {
            __rt_out_of_memory();
        }
        for (usize i = 0; i < __gc_stack_len; i++) {
            fresh[i] = __gc_stack[i];
        }
        __gc_stack = fresh;
        __gc_stack_cap = cap;
    }
    __gc_stack[__gc_stack_len] = h as u64;
    __gc_stack_len++;
}

function __gc_mark(u8* h): void {
    u64 head = *(h as u64*);
    if ((head & __GC_MARK) != 0) {
        return;
    }
    *(h as u64*) = head | __GC_MARK;
    if ((head & __GC_NOSCAN) == 0) {
        __gc_push(h);
    }
}

// Marks whatever the words in [lo, hi) point into.
function __gc_scan(u64 lo, u64 hi): void {
    for (u64 a = (lo + 7) & ~7; a + 8 <= hi; a += 8) {
        u64 v = *(a as u64*);
        if (v >= __gc_lo && v < __gc_hi) {
            u8* h = __gc_find(v);
            if (h != null) {
                __gc_mark(h);
            }
        }
    }
}

function __gc_drain(): void {
    while (__gc_stack_len > 0) {
        __gc_stack_len--;
        u8* h = __gc_stack[__gc_stack_len] as u8*;
        __gc_scan(h as u64 + 16, h as u64 + 16 + (*(h as u64*) & ~15));
    }
}

// Frees every unmarked object, merging neighbors into free blocks.
function __gc_sweep(): void {
    for (usize i = 0; i < 65; i++) {
        __gc_free[i] = null;
    }
    usize live = 0;
    for (usize i = 0; i < __gc_nchunks; i++) {
        __RtChunk* c = __gc_chunks + i;
        u8* h = c->start;
        u8* run = null;
        while (h < c->bump) {
            u64 head = *(h as u64*);
            usize size = head & ~15;
            bool alive = (head & __GC_MARK) != 0 || (head & (__GC_MANUAL | __GC_FREE)) == __GC_MANUAL;
            if (alive) {
                if (run != null) {
                    __gc_push_free(run, (h - run) as usize - 16);
                    run = null;
                }
                *(h as u64*) = head & ~__GC_MARK;
                live += size + 16;
            } else if (run == null) {
                run = h;
            } else {
                __gc_clear_bit(c, h);   // merged into the run
            }
            h += 16 + size;
        }
        if (run != null && i + 1 == __gc_cur) {   // free space at the end goes back to the bump area
            __gc_clear_bit(c, run);
            c->bump = run;
        } else if (run != null) {
            __gc_push_free(run, (c->bump - run) as usize - 16);
        }
    }
    __gc_live = live;
}

function __rt_gc_collect(): void {
    __rt_save_regs(&__gc_regs[0]);
    u64 sp = __rt_stack_pointer();
    if (__rt_stack_base != 0) {
        __gc_scan(sp, __rt_stack_base);
    }
    __gc_scan(&__gc_regs[0] as u64, &__gc_regs[0] as u64 + 48);
    u64* roots = __rt_gc_roots();
    for (u64 i = 0; i < roots[0]; i++) {
        __gc_scan(roots[1 + 2 * i], roots[1 + 2 * i] + roots[2 + 2 * i]);
    }
    for (usize i = 0; i < __gc_nchunks; i++) {   // alloc memory is a root
        __RtChunk* c = __gc_chunks + i;
        for (u8* h = c->start; h < c->bump; h += 16 + (*(h as u64*) & ~15)) {
            if ((*(h as u64*) & (__GC_MANUAL | __GC_FREE)) == __GC_MANUAL) {
                __gc_mark(h);
            }
        }
    }
    __gc_drain();
    __gc_sweep();
    __gc_collections++;
    __gc_since = 0;
    __gc_threshold = __gc_live > 4194304 ? __gc_live : 4194304;
}

// For std/gc.
function __rt_gc_live(): usize {
    return __gc_live;
}

function __rt_gc_heap(): usize {
    return __gc_heap;
}

function __rt_gc_count(): usize {
    return __gc_collections;
}

function __rt_copy(u8* dst, const u8* src, usize n): void {
    for (usize i = 0; i < n; i++) {
        dst[i] = src[i];
    }
}

// Copies bytes into a new NUL-terminated string, so `s->ptr` can always be
// passed to C.
function __rt_new_string(const u8* src, usize n): string {
    u8* p = __rt_alloc_bytes(n + 1);
    __rt_copy(p, src, n);
    return string { ptr: p, len: n };
}

// ---- strings -------------------------------------------------------------

function __rt_concat(string a, string b): string {
    usize n = a->len + b->len;
    u8* p = __rt_alloc_bytes(n + 1);
    __rt_copy(p, a->ptr, a->len);
    __rt_copy(p + a->len, b->ptr, b->len);
    return string { ptr: p, len: n };
}

function __rt_str_eq(string a, string b): bool {
    if (a->len != b->len) {
        return false;
    }
    for (usize i = 0; i < a->len; i++) {
        if (a->ptr[i] != b->ptr[i]) {
            return false;
        }
    }
    return true;
}

// Byte-wise comparison: negative, zero or positive.
function __rt_str_cmp(string a, string b): int {
    usize n = a->len < b->len ? a->len : b->len;
    for (usize i = 0; i < n; i++) {
        if (a->ptr[i] != b->ptr[i]) {
            return (a->ptr[i] as int) - (b->ptr[i] as int);
        }
    }
    if (a->len == b->len) {
        return 0;
    }
    return a->len < b->len ? -1 : 1;
}

// ---- formatting ----------------------------------------------------------
// Digits are written backwards into the end of `buf`; the return value is
// where they start.

function __rt_fmt_u64(u64 v, u8* buf): usize {
    usize i = 20;
    do {
        i--;
        buf[i] = (48 + v % 10) as u8;
        v /= 10;
    } while (v != 0);
    return i;
}

function __rt_fmt_hex(u64 v, u8* buf): usize {
    usize i = 20;
    do {
        i--;
        u64 d = v & 15;
        buf[i] = (d < 10 ? 48 + d : 87 + d) as u8;
        v >>= 4;
    } while (v != 0);
    i--;
    buf[i] = 120;   // x
    i--;
    buf[i] = 48;    // 0
    return i;
}

function __rt_u64_to_string(u64 v): string {
    u8[20] buf;
    usize start = __rt_fmt_u64(v, &buf[0]);
    return __rt_new_string(&buf[start], 20 - start);
}

function __rt_i64_to_string(i64 v): string {
    if (v < 0) {
        return __rt_concat("-", __rt_u64_to_string(0 - (v as u64)));
    }
    return __rt_u64_to_string(v as u64);
}

function __rt_ptr_to_string(u64 v): string {
    if (v == 0) {
        return "null";
    }
    u8[20] buf;
    usize start = __rt_fmt_hex(v, &buf[0]);
    return __rt_new_string(&buf[start], 20 - start);
}

function __rt_bool_to_string(bool b): string {
    return b ? "true" : "false";
}

function __rt_f64_to_string(f64 x): string {
    u8[32] buf;
    usize n = __rt_fmt_f64(x, &buf[0]);
    return __rt_new_string(&buf[0], n);
}

// ---- echo ----------------------------------------------------------------
// These write directly, without building a string first.

function __rt_echo_str(string s): void {
    __rt_out(s->ptr, s->len);
}

function __rt_echo_u64(u64 v): void {
    u8[20] buf;
    usize start = __rt_fmt_u64(v, &buf[0]);
    __rt_out(&buf[start], 20 - start);
}

function __rt_echo_i64(i64 v): void {
    if (v < 0) {
        __rt_out("-", 1);
        __rt_echo_u64(0 - (v as u64));
        return;
    }
    __rt_echo_u64(v as u64);
}

function __rt_echo_ptr(u64 v): void {
    if (v == 0) {
        __rt_out("null", 4);
        return;
    }
    u8[20] buf;
    usize start = __rt_fmt_hex(v, &buf[0]);
    __rt_out(&buf[start], 20 - start);
}

function __rt_echo_bool(bool b): void {
    __rt_echo_str(b ? "true" : "false");
}

function __rt_echo_f64(f64 x): void {
    u8[32] buf;
    usize n = __rt_fmt_f64(x, &buf[0]);
    __rt_out(&buf[0], n);
}

// ---- mixed: a tagged value -----------------------------------------------
// tag: 0 null, 1 bool, 2 int, 3 float, 4 string (bits point to a boxed
// {ptr, len}), 5 array, 16 + n an object of class n. The compiler converts
// values to mixed through these functions, and back with __rt_as_*.

const u64 __M_NULL = 0;
const u64 __M_BOOL = 1;
const u64 __M_INT = 2;
const u64 __M_FLOAT = 3;
const u64 __M_STRING = 4;
const u64 __M_ARRAY = 5;
const u64 __M_OBJECT = 16;

function __rt_mixed_null(): mixed {
    return mixed { tag: __M_NULL, bits: 0 };
}

function __rt_mixed_bool(bool b): mixed {
    return mixed { tag: __M_BOOL, bits: b as u64 };
}

function __rt_mixed_int(i64 v): mixed {
    return mixed { tag: __M_INT, bits: v as u64 };
}

function __rt_mixed_float(f64 v): mixed {
    f64 copy = v;
    return mixed { tag: __M_FLOAT, bits: *(&copy as u64*) };
}

function __rt_mixed_string(string s): mixed {
    string* box = __rt_alloc(16) as string*;
    *box = s;
    return mixed { tag: __M_STRING, bits: box as u64 };
}

function __rt_mixed_array(array a): mixed {
    if (a == null) {
        return mixed { tag: __M_NULL, bits: 0 };
    }
    return mixed { tag: __M_ARRAY, bits: a as u64 };
}

function __rt_mixed_object(u64 obj): mixed {
    if (obj == 0) {
        return mixed { tag: __M_NULL, bits: 0 };
    }
    return mixed { tag: __M_OBJECT, bits: obj };
}

function __rt_mixed_type(mixed m): string {
    if (m->tag == __M_NULL) { return "null"; }
    if (m->tag == __M_BOOL) { return "bool"; }
    if (m->tag == __M_INT) { return "int"; }
    if (m->tag == __M_FLOAT) { return "float"; }
    if (m->tag == __M_STRING) { return "string"; }
    if (m->tag == __M_ARRAY) { return "array"; }
    return "object";
}

// Panics at `where` (a "file:line:col" string) if m isn't `want`.
function __rt_mixed_expect(mixed m, u64 tag, string want, string where): void {
    if (m->tag != tag) {
        __rt_panic(__rt_concat(__rt_concat(__rt_concat(__rt_concat(__rt_concat("panic at ", where), ": expected "), want),
                                           ", found "), __rt_concat(__rt_mixed_type(m), "\n")));
    }
}

function __rt_as_bool(mixed m, string where): bool {
    __rt_mixed_expect(m, __M_BOOL, "bool", where);
    return m->bits != 0;
}

function __rt_as_int(mixed m, string where): i64 {
    __rt_mixed_expect(m, __M_INT, "int", where);
    return m->bits as i64;
}

function __rt_as_float(mixed m, string where): f64 {
    if (m->tag == __M_INT) {   // ints read as floats, like PHP
        return (m->bits as i64) as f64;
    }
    __rt_mixed_expect(m, __M_FLOAT, "float", where);
    u64 bits = m->bits;
    return *(&bits as f64*);
}

function __rt_as_string(mixed m, string where): string {
    __rt_mixed_expect(m, __M_STRING, "string", where);
    return *(m->bits as string*);
}

// null reads as an empty array.
function __rt_as_array(mixed m, string where): array {
    if (m->tag == __M_NULL) {
        return null;
    }
    __rt_mixed_expect(m, __M_ARRAY, "array", where);
    return m->bits as array;
}

function __rt_as_object(mixed m, u64 desc, bool iface, string class_name, string where): u64 {
    if (m->tag == __M_NULL) {
        return 0;
    }
    __rt_mixed_expect(m, __M_OBJECT, class_name, where);
    return __rt_cast_object(m->bits, desc, iface, class_name, where);
}

function __rt_mixed_instanceof(mixed m, u64 desc, bool iface): bool {
    return m->tag == __M_OBJECT && __rt_instanceof(m->bits, desc, iface);
}

function __rt_mixed_to_string(mixed m): string {
    if (m->tag == __M_NULL) { return ""; }
    if (m->tag == __M_BOOL) { return m->bits != 0 ? "true" : "false"; }
    if (m->tag == __M_INT) { return __rt_i64_to_string(m->bits as i64); }
    if (m->tag == __M_FLOAT) {
        u64 bits = m->bits;
        return __rt_f64_to_string(*(&bits as f64*));
    }
    if (m->tag == __M_STRING) { return *(m->bits as string*); }
    if (m->tag == __M_ARRAY) { return "Array"; }
    return __rt_class_name(m->bits);
}

// Strict equality, like PHP's ===: same type and same value.
function __rt_mixed_eq(mixed a, mixed b): bool {
    if (a->tag != b->tag) {
        return false;
    }
    if (a->tag == __M_STRING) {
        return __rt_str_eq(*(a->bits as string*), *(b->bits as string*));
    }
    if (a->tag == __M_FLOAT) {
        u64 x = a->bits;
        u64 y = b->bits;
        return *(&x as f64*) == *(&y as f64*);
    }
    return a->bits == b->bits;
}

// ---- array: PHP's ordered map ------------------------------------------
// Entries are kept in insertion order; removing one leaves a hole that's
// skipped. A hash table of entry numbers finds keys. Keys are ints or
// strings.

struct __RtEntry {
    mixed key;
    mixed value;
    u64 hash;
    bool live;
}

struct __RtArray {
    __RtEntry* entries;
    usize used;          // entries in use, holes included
    usize cap;
    usize count;         // live entries
    i64* table;          // entry number + 1; 0 = empty
    usize table_cap;     // a power of two, at least twice `used`
    i64 next_key;        // the key `a[] = v` uses
}

function __rt_array_new(usize cap): array {
    __RtArray* a = __rt_alloc(sizeof(__RtArray)) as __RtArray*;
    if (cap > 0) {
        a->entries = __rt_alloc(cap * sizeof(__RtEntry)) as __RtEntry*;
        a->cap = cap;
    }
    return a as array;
}

function __rt_array_null_write(): void {
    __rt_panic("panic: writing to a null array (initialize it first, for example with [])\n");
}

// Hashes, also behind the `hash_of(x)` builtin.
function __rt_str_hash(string s): u64 {   // FNV-1a
    u64 h = 14695981039346656037;
    for (usize i = 0; i < s->len; i++) {
        h = (h ^ s->ptr[i] as u64) * 1099511628211;
    }
    return h;
}

function __rt_int_hash(u64 x): u64 {   // splitmix64's finalizer
    x = x + 11400714819323198485;
    x = (x ^ (x >> 30)) * 13787848793156543929;
    x = (x ^ (x >> 27)) * 10723151780598845931;
    return x ^ (x >> 31);
}

function __rt_f64_hash(f64 x): u64 {
    if (x == 0.0) {   // -0.0 == 0.0, so they must hash alike
        return __rt_int_hash(0);
    }
    return __rt_int_hash(*((&x) as u64*));
}

function __rt_key_hash(mixed key): u64 {
    if (key->tag == __M_STRING) {
        return __rt_str_hash(*(key->bits as string*));
    }
    return __rt_int_hash(key->bits);
}

function __rt_key_check(mixed key): mixed {
    if (key->tag == __M_INT || key->tag == __M_STRING) {
        return key;
    }
    if (key->tag == __M_BOOL) {   // like PHP: true is 1, false is 0
        return mixed { tag: __M_INT, bits: key->bits };
    }
    __rt_panic(__rt_concat(__rt_concat("panic: array keys must be ints or strings, found ", __rt_mixed_type(key)), "\n"));
    return key;
}

// The entry number of `key`, or -1.
function __rt_array_find(__RtArray* a, mixed key, u64 hash): i64 {
    if (a->table_cap == 0) {
        return -1;
    }
    usize mask = a->table_cap - 1;
    for (usize i = hash as usize & mask; ; i = (i + 1) & mask) {
        i64 slot = a->table[i];
        if (slot == 0) {
            return -1;
        }
        __RtEntry* e = a->entries + (slot - 1);
        if (e->hash == hash && e->live && __rt_mixed_eq(e->key, key)) {
            return slot - 1;
        }
    }
}

function __rt_array_rehash(__RtArray* a, usize table_cap): void {
    a->table = __rt_alloc_bytes(table_cap * 8) as i64*;
    a->table_cap = table_cap;
    usize mask = table_cap - 1;
    for (usize n = 0; n < a->used; n++) {
        __RtEntry* e = a->entries + n;
        if (!e->live) {
            continue;
        }
        usize i = e->hash as usize & mask;
        while (a->table[i] != 0) {
            i = (i + 1) & mask;
        }
        a->table[i] = (n + 1) as i64;
    }
}

function __rt_array_add(__RtArray* a, mixed key, u64 hash, mixed value): void {
    if (a->used == a->cap) {
        if (a->count < a->used / 2) {   // mostly holes: squeeze them out
            usize to = 0;
            for (usize n = 0; n < a->used; n++) {
                if (a->entries[n]->live) {
                    a->entries[to] = a->entries[n];
                    to++;
                }
            }
            for (usize n = to; n < a->used; n++) {
                a->entries[n]->live = false;
            }
            a->used = to;
        } else {
            usize cap = a->cap < 8 ? 8 : a->cap * 2;
            __RtEntry* fresh = __rt_alloc(cap * sizeof(__RtEntry)) as __RtEntry*;
            for (usize n = 0; n < a->used; n++) {
                fresh[n] = a->entries[n];
            }
            a->entries = fresh;
            a->cap = cap;
        }
        __rt_array_rehash(a, a->table_cap == 0 ? 16 : a->table_cap);
    }
    if ((a->used + 1) * 2 > a->table_cap) {
        __rt_array_rehash(a, a->table_cap == 0 ? 16 : a->table_cap * 2);
    }
    __RtEntry* e = a->entries + a->used;
    e->key = key;
    e->value = value;
    e->hash = hash;
    e->live = true;
    usize mask = a->table_cap - 1;
    usize i = hash as usize & mask;
    while (a->table[i] != 0) {
        i = (i + 1) & mask;
    }
    a->table[i] = (a->used + 1) as i64;
    a->used++;
    a->count++;
    if (key->tag == __M_INT && key->bits as i64 >= a->next_key) {
        a->next_key = key->bits as i64 + 1;
    }
}

function __rt_array_get(array arr, mixed key): mixed {
    __RtArray* a = arr as __RtArray*;
    if (a == null) {
        return mixed { tag: __M_NULL, bits: 0 };
    }
    key = __rt_key_check(key);
    i64 n = __rt_array_find(a, key, __rt_key_hash(key));
    if (n < 0) {
        return mixed { tag: __M_NULL, bits: 0 };
    }
    return a->entries[n]->value;
}

function __rt_array_set(array arr, mixed key, mixed value): void {
    __RtArray* a = arr as __RtArray*;
    if (a == null) {
        __rt_array_null_write();
    }
    key = __rt_key_check(key);
    u64 hash = __rt_key_hash(key);
    i64 n = __rt_array_find(a, key, hash);
    if (n >= 0) {
        a->entries[n]->value = value;
        return;
    }
    __rt_array_add(a, key, hash, value);
}

function __rt_array_push(array arr, mixed value): void {
    __RtArray* a = arr as __RtArray*;
    if (a == null) {
        __rt_array_null_write();
    }
    mixed key = mixed { tag: __M_INT, bits: a->next_key as u64 };
    __rt_array_add(a, key, __rt_key_hash(key), value);
}

function __rt_array_has(array arr, mixed key): bool {
    __RtArray* a = arr as __RtArray*;
    if (a == null) {
        return false;
    }
    key = __rt_key_check(key);
    return __rt_array_find(a, key, __rt_key_hash(key)) >= 0;
}

function __rt_array_remove(array arr, mixed key): bool {
    __RtArray* a = arr as __RtArray*;
    if (a == null) {
        return false;
    }
    key = __rt_key_check(key);
    i64 n = __rt_array_find(a, key, __rt_key_hash(key));
    if (n < 0) {
        return false;
    }
    a->entries[n]->live = false;
    a->entries[n]->value = mixed { tag: __M_NULL, bits: 0 };
    a->count--;   // its table slot stays, so probes for other keys still pass it
    return true;
}

function __rt_array_len(array arr): usize {
    __RtArray* a = arr as __RtArray*;
    return a == null ? 0 : a->count;
}

// foreach walks entry numbers 0 .. __rt_array_slots(a), skipping holes.
function __rt_array_slots(array arr): usize {
    __RtArray* a = arr as __RtArray*;
    return a == null ? 0 : a->used;
}

function __rt_array_live(array arr, usize n): bool {
    __RtArray* a = arr as __RtArray*;
    return n < a->used && a->entries[n]->live;
}

function __rt_array_key(array arr, usize n): mixed {
    __RtArray* a = arr as __RtArray*;
    return a->entries[n]->key;
}

function __rt_array_value(array arr, usize n): mixed {
    __RtArray* a = arr as __RtArray*;
    return a->entries[n]->value;
}

// ---- without a heap -------------------------------------------------------

u8[21] __rt_num_buf;

// A number as text in a static buffer, for --freestanding programs (it's
// overwritten by the next call).
function __rt_static_num_to_string(i64 v): string {
    usize start = __rt_fmt_u64(v < 0 ? 0 - (v as u64) : v as u64, &__rt_num_buf[1]);
    if (v < 0) {
        __rt_num_buf[start] = 45;   // -
        return string { ptr: &__rt_num_buf[start], len: 21 - start };
    }
    return string { ptr: &__rt_num_buf[start + 1], len: 20 - start };
}

// ---- classes ----------------------------------------------------------------
// Every object starts with a pointer to its class's descriptor:
//   [0] the parent class's descriptor (0 for none)
//   [1] [2] the class name (ptr, len)
//   [3] how many interfaces it implements, [4] a list of (interface, table) pairs
//   [5...] the vtable
// An interface's descriptor only has its name; its address identifies it.

function __rt_instanceof(u64 obj, u64 desc, bool iface): bool {
    if (obj == 0) {
        return false;
    }
    u64* c = *(obj as u64**);
    if (iface) {
        u64* list = c[4] as u64*;
        for (u64 i = 0; i < c[3]; i++) {
            if (list[2 * i] == desc) {
                return true;
            }
        }
        return false;
    }
    while (c != null) {
        if (c as u64 == desc) {
            return true;
        }
        c = c[0] as u64*;
    }
    return false;
}

function __rt_class_name(u64 obj): string {
    u64* c = *(obj as u64**);
    return string { ptr: c[1] as const u8*, len: c[2] };
}

// `obj as Class` when that's a downcast: panics at `where` unless obj is one.
function __rt_cast_object(u64 obj, u64 desc, bool iface, string class_name, string where): u64 {
    if (obj == 0 || __rt_instanceof(obj, desc, iface)) {
        return obj;
    }
    __rt_panic(__rt_concat(__rt_concat(__rt_concat(__rt_concat(__rt_concat("panic at ", where), ": expected "),
                                                   class_name), ", found "), __rt_concat(__rt_class_name(obj), "\n")));
    return 0;
}
