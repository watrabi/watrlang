// Numbers. The f64 functions beyond the basics come from the C math
// library, which is linked automatically when they're used.

const f64 PI = 3.14159265358979323846;
const f64 E = 2.71828182845904523536;

function abs(int x): int {
    return x < 0 ? -x : x;
}

function min(int a, int b): int {
    return a < b ? a : b;
}

function max(int a, int b): int {
    return a > b ? a : b;
}

function clamp(int x, int lo, int hi): int {
    return x < lo ? lo : x > hi ? hi : x;
}

function fabs(f64 x): f64 {
    return x < 0.0 ? -x : x;
}

function fmin(f64 a, f64 b): f64 {
    return a < b ? a : b;
}

function fmax(f64 a, f64 b): f64 {
    return a > b ? a : b;
}

// Greatest common divisor.
function gcd(int a, int b): int {
    a = abs(a);
    b = abs(b);
    while (b != 0) {
        int t = b;
        b = a % b;
        a = t;
    }
    return a;
}

// x to the power n, by squaring (n >= 0).
function ipow(int x, int n): int {
    int result = 1;
    while (n > 0) {
        if (n % 2 == 1) {
            result *= x;
        }
        x *= x;
        n /= 2;
    }
    return result;
}

extern function sqrt(f64 x): f64;
extern function pow(f64 x, f64 y): f64;
extern function floor(f64 x): f64;
extern function ceil(f64 x): f64;
extern function round(f64 x): f64;
extern function sin(f64 x): f64;
extern function cos(f64 x): f64;
extern function tan(f64 x): f64;
extern function atan2(f64 y, f64 x): f64;
extern function exp(f64 x): f64;
extern function log(f64 x): f64;
