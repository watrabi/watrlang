// Files, on Linux and Windows. Failures come back as IoError values:
//
//     import "std/fs";
//     string text = fs::read("notes.txt") ?? "";   // or `?` to pass the error on
//     bool saved = fs::write("out.txt", "hello\n") ?? false;

import "std/platform";

enum IoError { NotFound, Denied, Exists, IsDir, NotDir, NotEmpty, Other }

// The IoError for a negative result (-errno, as std/platform returns).
function error_of(i64 r): IoError {
    if (r == -2) { return IoError::NotFound; }
    if (r == -13 || r == -1) { return IoError::Denied; }
    if (r == -17) { return IoError::Exists; }
    if (r == -21) { return IoError::IsDir; }
    if (r == -20) { return IoError::NotDir; }
    if (r == -39) { return IoError::NotEmpty; }
    return IoError::Other;
}

// A sentence describing e, for messages.
function describe(IoError e): string {
    if (e == IoError::NotFound) { return "no such file or directory"; }
    if (e == IoError::Denied) { return "permission denied"; }
    if (e == IoError::Exists) { return "already exists"; }
    if (e == IoError::IsDir) { return "is a directory"; }
    if (e == IoError::NotDir) { return "not a directory"; }
    if (e == IoError::NotEmpty) { return "directory not empty"; }
    return "input/output error";
}

private function open(string path, int mode): i64!IoError {
    i64 fd = platform::open(path, mode);
    if (fd < 0) {
        return error_of(fd);
    }
    return fd;
}

// The whole file as a string.
function read(string path): string!IoError {
    i64 fd = open(path, platform::READ)?;
    defer platform::close(fd);
    usize cap = 4096;
    usize n = 0;
    u8* buf = __rt_alloc_bytes(cap + 1);
    while (true) {
        if (n == cap) {
            u8* bigger = __rt_alloc_bytes(cap * 2 + 1);
            __rt_copy(bigger, buf, n);
            buf = bigger;
            cap = cap * 2;
        }
        i64 got = platform::read(fd, buf + n, cap - n);
        if (got < 0) {
            return error_of(got);
        }
        if (got == 0) {
            break;
        }
        n += got as usize;
    }
    return string { ptr: buf, len: n };
}

private function write_all(i64 fd, string data): bool!IoError {
    usize done = 0;
    while (done < len(data)) {
        i64 put = platform::write(fd, data->ptr + done, len(data) - done);
        if (put < 0) {
            return error_of(put);
        }
        done += put as usize;
    }
    return true;
}

// Replaces the file's contents (creating it if needed).
function write(string path, string data): bool!IoError {
    i64 fd = open(path, platform::WRITE)?;
    defer platform::close(fd);
    return write_all(fd, data);
}

// Adds to the end of the file (creating it if needed).
function append(string path, string data): bool!IoError {
    i64 fd = open(path, platform::APPEND)?;
    defer platform::close(fd);
    return write_all(fd, data);
}

function exists(string path): bool {
    return platform::exists(path);
}

private function check(i64 r): bool!IoError {
    if (r < 0) {
        return error_of(r);
    }
    return true;
}

function remove(string path): bool!IoError { return check(platform::remove(path)); }
function rename(string from, string to): bool!IoError { return check(platform::rename(from, to)); }
function mkdir(string path): bool!IoError { return check(platform::mkdir(path)); }
function rmdir(string path): bool!IoError { return check(platform::rmdir(path)); }

// The file's size in bytes.
function size(string path): i64!IoError {
    i64 fd = open(path, platform::READ)?;
    defer platform::close(fd);
    i64 end = platform::size(fd);
    if (end < 0) {
        return error_of(end);
    }
    return end;
}
