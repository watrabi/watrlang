// The process: command-line arguments, environment variables, exiting.

import "std/platform";
import "std/vec";

private function cstr_len(const u8* p): usize {
    usize n = 0;
    while (p[n] != 0) {
        n++;
    }
    return n;
}

// The command line: args()[0] is the program, then its arguments.
function args(): vec::Vec<string> {
    vec::Vec<string> out = new vec::Vec<string>();
    for (u64 i = 0; i < __rt_argc; i++) {
        u8* a = __rt_argv[i];
        out->push(string { ptr: a, len: cstr_len(a) });
    }
    return out;
}

// How many arguments there are, not counting the program.
function argc(): int { return __rt_argc as int - 1; }

// Does the environment entry `e` ("NAME=value") define `name`?
private function env_is(const u8* e, string name): bool {
    for (usize j = 0; j < len(name); j++) {
        u8 a = e[j];
        u8 b = name[j];
        if (platform::ENV_IGNORES_CASE) {
            a = a >= 'a' && a <= 'z' ? a - 32 : a;
            b = b >= 'a' && b <= 'z' ? b - 32 : b;
        }
        if (a != b) {   // also stops at e's NUL, which name doesn't have
            return false;
        }
    }
    return e[len(name)] == '=';
}

// The environment variable `name`, or "" if it isn't set.
function getenv(string name): string {
    if (__rt_envp == null) {
        return "";
    }
    for (usize i = 0; __rt_envp[i] != null; i++) {
        u8* e = __rt_envp[i];
        if (env_is(e, name)) {
            return string { ptr: e + len(name) + 1, len: cstr_len(e) - len(name) - 1 };
        }
    }
    return "";
}

function has_env(string name): bool {
    if (__rt_envp == null) {
        return false;
    }
    for (usize i = 0; __rt_envp[i] != null; i++) {
        if (env_is(__rt_envp[i], name)) {
            return true;
        }
    }
    return false;
}

// Ends the program now, with exit code `code`. (Deferred code doesn't run.)
function exit(int code): void {
    __rt_exit(code);
}

function pid(): int { return platform::pid(); }
