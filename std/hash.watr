private u8[64] MD5_S = [
    7, 12, 17, 22, 7, 12, 17, 22, 7, 12, 17, 22, 7, 12, 17, 22,
    5, 9, 14, 20, 5, 9, 14, 20, 5, 9, 14, 20, 5, 9, 14, 20,
    4, 11, 16, 23, 4, 11, 16, 23, 4, 11, 16, 23, 4, 11, 16, 23,
    6, 10, 15, 21, 6, 10, 15, 21, 6, 10, 15, 21, 6, 10, 15, 21
];

private function rotr32(u32 x, u32 n): u32 { return (x >> n) | (x << (32 - n)); }
private function rotl32(u32 x, u32 n): u32 { return (x << n) | (x >> (32 - n)); }
private function rotr64(u64 x, u64 n): u64 { return (x >> n) | (x << (64 - n)); }

private function load_be32(const u8* p): u32 {
    return (p[0] as u32 << 24) | (p[1] as u32 << 16) | (p[2] as u32 << 8) | (p[3] as u32);
}

private function load_be64(const u8* p): u64 {
    u64 v = 0;
    for (usize i = 0; i < 8; i++) {
        v = (v << 8) | (p[i] as u64);
    }
    return v;
}

private function load_le64(const u8* p): u64 {
    u64 v = 0;
    for (int i = 7; i >= 0; i--) {
        v = (v << 8) | (p[i] as u64);
    }
    return v;
}

private function bytes_of(u8* p, usize n): string {
    return string { ptr: p, len: n };
}

// --- SHA-256 ---

private function c256(u32* h, const u8* p) {
    u32[64] w;
    for (usize i = 0; i < 16; i++) {
        w[i] = load_be32(p + i * 4);
    }
    for (usize t = 16; t < 64; t++) {
        u32 s0 = rotr32(w[t - 15], 7) ^ rotr32(w[t - 15], 18) ^ (w[t - 15] >> 3);
        u32 s1 = rotr32(w[t - 2], 17) ^ rotr32(w[t - 2], 19) ^ (w[t - 2] >> 10);
        w[t] = w[t - 16] + s0 + w[t - 7] + s1;
    }
    u32 a = h[0]; u32 b = h[1]; u32 c = h[2]; u32 d = h[3];
    u32 e = h[4]; u32 f = h[5]; u32 g = h[6]; u32 hh = h[7];
    for (usize j = 0; j < 64; j++) {
        u32 t1 = hh + (rotr32(e, 6) ^ rotr32(e, 11) ^ rotr32(e, 25)) + ((e & f) ^ (~e & g)) + K256[j] + w[j];
        u32 t2 = (rotr32(a, 2) ^ rotr32(a, 13) ^ rotr32(a, 22)) + ((a & b) ^ (a & c) ^ (b & c));
        hh = g; g = f; f = e; e = d + t1; d = c; c = b; b = a; a = t1 + t2;
    }
    h[0] += a; h[1] += b; h[2] += c; h[3] += d; h[4] += e; h[5] += f; h[6] += g; h[7] += hh;
}

private function init256(u32* h) {
    h[0] = 0x6a09e667; h[1] = 0xbb67ae85; h[2] = 0x3c6ef372; h[3] = 0xa54ff53a;
    h[4] = 0x510e527f; h[5] = 0x9b05688c; h[6] = 0x1f83d9ab; h[7] = 0x5be0cd19;
}

// Hashes data[0..n) into state h, which has already absorbed `before` bytes
// (a multiple of 64), then pads and writes the 32-byte digest to out.
private function finish256(u32* h, const u8* data, usize n, u64 before, u8* out) {
    usize full = n / 64;
    for (usize i = 0; i < full; i++) {
        c256(h, data + i * 64);
    }
    u8[128] tail;
    usize rest = n - full * 64;
    for (usize j = 0; j < 128; j++) {
        tail[j] = 0;
    }
    for (usize k = 0; k < rest; k++) {
        tail[k] = data[full * 64 + k];
    }
    tail[rest] = 0x80;
    usize blocks = rest + 9 > 64 ? 2 : 1;
    u64 bits = (before + n as u64) * 8;
    for (usize b = 0; b < 8; b++) {
        tail[blocks * 64 - 1 - b] = ((bits >> ((b * 8) as u64)) & 0xff) as u8;
    }
    c256(h, &tail[0]);
    if (blocks == 2) {
        c256(h, &tail[64]);
    }
    for (usize q = 0; q < 8; q++) {
        out[q * 4] = (h[q] >> 24) as u8;
        out[q * 4 + 1] = (h[q] >> 16) as u8;
        out[q * 4 + 2] = (h[q] >> 8) as u8;
        out[q * 4 + 3] = h[q] as u8;
    }
}

// SHA-256: 32 bytes.
function sha256(string data): string {
    u32[8] h;
    init256(&h[0]);
    u8* out = __rt_alloc_bytes(32);
    finish256(&h[0], data->ptr, len(data), 0, out);
    return bytes_of(out, 32);
}

// --- SHA-512 ---

private function c512(u64* h, const u8* p) {
    u64[80] w;
    for (usize i = 0; i < 16; i++) {
        w[i] = load_be64(p + i * 8);
    }
    for (usize t = 16; t < 80; t++) {
        u64 s0 = rotr64(w[t - 15], 1) ^ rotr64(w[t - 15], 8) ^ (w[t - 15] >> 7);
        u64 s1 = rotr64(w[t - 2], 19) ^ rotr64(w[t - 2], 61) ^ (w[t - 2] >> 6);
        w[t] = w[t - 16] + s0 + w[t - 7] + s1;
    }
    u64 a = h[0]; u64 b = h[1]; u64 c = h[2]; u64 d = h[3];
    u64 e = h[4]; u64 f = h[5]; u64 g = h[6]; u64 hh = h[7];
    for (usize j = 0; j < 80; j++) {
        u64 t1 = hh + (rotr64(e, 14) ^ rotr64(e, 18) ^ rotr64(e, 41)) + ((e & f) ^ (~e & g)) + K512[j] + w[j];
        u64 t2 = (rotr64(a, 28) ^ rotr64(a, 34) ^ rotr64(a, 39)) + ((a & b) ^ (a & c) ^ (b & c));
        hh = g; g = f; f = e; e = d + t1; d = c; c = b; b = a; a = t1 + t2;
    }
    h[0] += a; h[1] += b; h[2] += c; h[3] += d; h[4] += e; h[5] += f; h[6] += g; h[7] += hh;
}

private function init512(u64* h) {
    for (usize i = 0; i < 8; i++) {
        h[i] = IV512[i];
    }
}

private function finish512(u64* h, const u8* data, usize n, u64 before, u8* out) {
    usize full = n / 128;
    for (usize i = 0; i < full; i++) {
        c512(h, data + i * 128);
    }
    u8[256] tail;
    usize rest = n - full * 128;
    for (usize j = 0; j < 256; j++) {
        tail[j] = 0;
    }
    for (usize k = 0; k < rest; k++) {
        tail[k] = data[full * 128 + k];
    }
    tail[rest] = 0x80;
    usize blocks = rest + 17 > 128 ? 2 : 1;
    u64 bits = (before + n as u64) * 8;
    for (usize b = 0; b < 8; b++) {
        tail[blocks * 128 - 1 - b] = ((bits >> ((b * 8) as u64)) & 0xff) as u8;
    }
    c512(h, &tail[0]);
    if (blocks == 2) {
        c512(h, &tail[128]);
    }
    for (usize q = 0; q < 8; q++) {
        for (usize r = 0; r < 8; r++) {
            out[q * 8 + r] = ((h[q] >> ((56 - r * 8) as u64)) & 0xff) as u8;
        }
    }
}

// SHA-512: 64 bytes.
function sha512(string data): string {
    u64[8] h;
    init512(&h[0]);
    u8* out = __rt_alloc_bytes(64);
    finish512(&h[0], data->ptr, len(data), 0, out);
    return bytes_of(out, 64);
}

// --- SHA-1 (legacy) ---

// SHA-1: 20 bytes. Broken for security; only for old protocols.
function sha1(string data): string {
    usize n = len(data);
    usize total = ((n + 9 + 63) / 64) * 64;
    u8* m = alloc(u8, total);
    defer free(m);
    __rt_copy(m, data->ptr, n);
    m[n] = 0x80;
    u64 bits = (n as u64) * 8;
    for (usize b = 0; b < 8; b++) {
        m[total - 1 - b] = ((bits >> ((b * 8) as u64)) & 0xff) as u8;
    }
    u32[5] h = [0x67452301, 0xEFCDAB89, 0x98BADCFE, 0x10325476, 0xC3D2E1F0];
    u32[80] w;
    for (usize off = 0; off < total; off += 64) {
        for (usize i = 0; i < 16; i++) {
            w[i] = load_be32(m + off + i * 4);
        }
        for (usize t = 16; t < 80; t++) {
            w[t] = rotl32(w[t - 3] ^ w[t - 8] ^ w[t - 14] ^ w[t - 16], 1);
        }
        u32 a = h[0]; u32 b2 = h[1]; u32 c = h[2]; u32 d = h[3]; u32 e = h[4];
        for (usize j = 0; j < 80; j++) {
            u32 f = 0;
            u32 k = 0;
            if (j < 20) {
                f = (b2 & c) | (~b2 & d);
                k = 0x5A827999;
            } else if (j < 40) {
                f = b2 ^ c ^ d;
                k = 0x6ED9EBA1;
            } else if (j < 60) {
                f = (b2 & c) | (b2 & d) | (c & d);
                k = 0x8F1BBCDC;
            } else {
                f = b2 ^ c ^ d;
                k = 0xCA62C1D6;
            }
            u32 temp = rotl32(a, 5) + f + e + k + w[j];
            e = d; d = c; c = rotl32(b2, 30); b2 = a; a = temp;
        }
        h[0] += a; h[1] += b2; h[2] += c; h[3] += d; h[4] += e;
    }
    u8* out = __rt_alloc_bytes(20);
    for (usize q = 0; q < 5; q++) {
        out[q * 4] = (h[q] >> 24) as u8;
        out[q * 4 + 1] = (h[q] >> 16) as u8;
        out[q * 4 + 2] = (h[q] >> 8) as u8;
        out[q * 4 + 3] = h[q] as u8;
    }
    return bytes_of(out, 20);
}

// --- MD5 (legacy) ---

// MD5: 16 bytes. Broken for security; only for checksums and old protocols.
function md5(string data): string {
    usize n = len(data);
    usize total = ((n + 9 + 63) / 64) * 64;
    u8* m = alloc(u8, total);
    defer free(m);
    __rt_copy(m, data->ptr, n);
    m[n] = 0x80;
    u64 bits = (n as u64) * 8;
    for (usize b = 0; b < 8; b++) {
        m[total - 8 + b] = ((bits >> ((b * 8) as u64)) & 0xff) as u8;
    }
    u32 a0 = 0x67452301;
    u32 b0 = 0xefcdab89;
    u32 c0 = 0x98badcfe;
    u32 d0 = 0x10325476;
    u32[16] mw;
    for (usize off = 0; off < total; off += 64) {
        for (usize i = 0; i < 16; i++) {
            u8* p = m + off + i * 4;
            mw[i] = (p[0] as u32) | (p[1] as u32 << 8) | (p[2] as u32 << 16) | (p[3] as u32 << 24);
        }
        u32 a = a0; u32 b2 = b0; u32 c = c0; u32 d = d0;
        for (usize j = 0; j < 64; j++) {
            u32 f = 0;
            usize g = 0;
            if (j < 16) {
                f = (b2 & c) | (~b2 & d);
                g = j;
            } else if (j < 32) {
                f = (d & b2) | (~d & c);
                g = (5 * j + 1) % 16;
            } else if (j < 48) {
                f = b2 ^ c ^ d;
                g = (3 * j + 5) % 16;
            } else {
                f = c ^ (b2 | ~d);
                g = (7 * j) % 16;
            }
            f = f + a + MD5_K[j] + mw[g];
            a = d; d = c; c = b2;
            b2 = b2 + rotl32(f, MD5_S[j] as u32);
        }
        a0 += a; b0 += b2; c0 += c; d0 += d;
    }
    u8* out = __rt_alloc_bytes(16);
    u32[4] r = [a0, b0, c0, d0];
    for (usize q = 0; q < 4; q++) {
        out[q * 4] = r[q] as u8;
        out[q * 4 + 1] = (r[q] >> 8) as u8;
        out[q * 4 + 2] = (r[q] >> 16) as u8;
        out[q * 4 + 3] = (r[q] >> 24) as u8;
    }
    return bytes_of(out, 16);
}

// --- BLAKE2b ---

private function b2_g(u64* v, int a, int b, int c, int d, u64 x, u64 y) {
    v[a] = v[a] + v[b] + x;
    v[d] = rotr64(v[d] ^ v[a], 32);
    v[c] = v[c] + v[d];
    v[b] = rotr64(v[b] ^ v[c], 24);
    v[a] = v[a] + v[b] + y;
    v[d] = rotr64(v[d] ^ v[a], 16);
    v[c] = v[c] + v[d];
    v[b] = rotr64(v[b] ^ v[c], 63);
}

private function b2_compress(u64* h, const u8* block, u64 counter, bool last) {
    u64[16] v;
    u64[16] m;
    for (usize i = 0; i < 16; i++) {
        m[i] = load_le64(block + i * 8);
    }
    for (usize j = 0; j < 8; j++) {
        v[j] = h[j];
        v[j + 8] = IV512[j];
    }
    v[12] = v[12] ^ counter;
    if (last) {
        v[14] = ~v[14];
    }
    for (usize r = 0; r < 12; r++) {
        u8* s = &SIGMA[r * 16];
        b2_g(&v[0], 0, 4, 8, 12, m[s[0]], m[s[1]]);
        b2_g(&v[0], 1, 5, 9, 13, m[s[2]], m[s[3]]);
        b2_g(&v[0], 2, 6, 10, 14, m[s[4]], m[s[5]]);
        b2_g(&v[0], 3, 7, 11, 15, m[s[6]], m[s[7]]);
        b2_g(&v[0], 0, 5, 10, 15, m[s[8]], m[s[9]]);
        b2_g(&v[0], 1, 6, 11, 12, m[s[10]], m[s[11]]);
        b2_g(&v[0], 2, 7, 8, 13, m[s[12]], m[s[13]]);
        b2_g(&v[0], 3, 4, 9, 14, m[s[14]], m[s[15]]);
    }
    for (usize k = 0; k < 8; k++) {
        h[k] = h[k] ^ v[k] ^ v[k + 8];
    }
}

// BLAKE2b with an output of 1-64 bytes and an optional key (0-64 bytes; ""
// for none). The same as libsodium's crypto_generichash.
function blake2b(string data, usize out_len, string key): string {
    usize outn = out_len < 1 ? 1 : (out_len > 64 ? 64 : out_len);
    usize keyn = len(key) > 64 ? 64 : len(key);
    u64[8] h;
    init512(&h[0]);
    h[0] = h[0] ^ 0x01010000 ^ ((keyn as u64) << 8) ^ (outn as u64);
    usize total = len(data) + (keyn > 0 ? 128 : 0);
    u8* m = alloc(u8, total + 128);
    defer free(m);
    if (keyn > 0) {
        __rt_copy(m, key->ptr, keyn);
    }
    __rt_copy(m + (keyn > 0 ? 128 : 0), data->ptr, len(data));
    usize blocks = total == 0 ? 1 : (total + 127) / 128;
    for (usize i = 0; i < blocks; i++) {
        bool last = i + 1 == blocks;
        u64 counter = last ? total as u64 : ((i + 1) * 128) as u64;
        b2_compress(&h[0], m + i * 128, counter, last);
    }
    u8* out = __rt_alloc_bytes(64);
    for (usize q = 0; q < 8; q++) {
        for (usize r = 0; r < 8; r++) {
            out[q * 8 + r] = ((h[q] >> ((r * 8) as u64)) & 0xff) as u8;
        }
    }
    return bytes_of(out, outn);
}

// --- HMAC ---

// The hash states after absorbing the inner and outer key pads.
private function hmac256_state(string key, u32* inner, u32* outer) {
    string k = len(key) > 64 ? sha256(key) : key;
    u8[64] ip;
    u8[64] op;
    for (usize i = 0; i < 64; i++) {
        u8 kb = i < len(k) ? k[i] : 0;
        ip[i] = kb ^ 0x36;
        op[i] = kb ^ 0x5c;
    }
    init256(inner);
    c256(inner, &ip[0]);
    init256(outer);
    c256(outer, &op[0]);
}

private function hmac256_with(u32* inner, u32* outer, const u8* msg, usize n, u8* out) {
    u32[8] h;
    for (usize i = 0; i < 8; i++) {
        h[i] = inner[i];
    }
    u8[32] mid;
    finish256(&h[0], msg, n, 64, &mid[0]);
    for (usize j = 0; j < 8; j++) {
        h[j] = outer[j];
    }
    finish256(&h[0], &mid[0], 32, 64, out);
}

// HMAC-SHA-256: 32 bytes.
function hmac_sha256(string key, string message): string {
    u32[8] inner;
    u32[8] outer;
    hmac256_state(key, &inner[0], &outer[0]);
    u8* out = __rt_alloc_bytes(32);
    hmac256_with(&inner[0], &outer[0], message->ptr, len(message), out);
    return bytes_of(out, 32);
}

private function hmac512_state(string key, u64* inner, u64* outer) {
    string k = len(key) > 128 ? sha512(key) : key;
    u8[128] ip;
    u8[128] op;
    for (usize i = 0; i < 128; i++) {
        u8 kb = i < len(k) ? k[i] : 0;
        ip[i] = kb ^ 0x36;
        op[i] = kb ^ 0x5c;
    }
    init512(inner);
    c512(inner, &ip[0]);
    init512(outer);
    c512(outer, &op[0]);
}

private function hmac512_with(u64* inner, u64* outer, const u8* msg, usize n, u8* out) {
    u64[8] h;
    for (usize i = 0; i < 8; i++) {
        h[i] = inner[i];
    }
    u8[64] mid;
    finish512(&h[0], msg, n, 128, &mid[0]);
    for (usize j = 0; j < 8; j++) {
        h[j] = outer[j];
    }
    finish512(&h[0], &mid[0], 64, 128, out);
}

// HMAC-SHA-512: 64 bytes.
function hmac_sha512(string key, string message): string {
    u64[8] inner;
    u64[8] outer;
    hmac512_state(key, &inner[0], &outer[0]);
    u8* out = __rt_alloc_bytes(64);
    hmac512_with(&inner[0], &outer[0], message->ptr, len(message), out);
    return bytes_of(out, 64);
}

// HMAC-SHA-1: 20 bytes (legacy protocols, TOTP).
function hmac_sha1(string key, string message): string {
    string k = len(key) > 64 ? sha1(key) : key;
    u8* ip = __rt_alloc_bytes(64);
    u8* op = __rt_alloc_bytes(64);
    for (usize i = 0; i < 64; i++) {
        u8 kb = i < len(k) ? k[i] : 0;
        ip[i] = kb ^ 0x36;
        op[i] = kb ^ 0x5c;
    }
    return sha1(bytes_of(op, 64) . sha1(bytes_of(ip, 64) . message));
}

// --- HKDF (RFC 5869) ---

// Derives `length` bytes (at most 8160) from input key material.
// salt may be ""; info separates keys for different purposes.
function hkdf_sha256(string ikm, string salt, string info, usize length): string {
    string s = len(salt) > 0 ? salt : bytes_of(__rt_alloc_bytes(32), 32);
    string prk = hmac_sha256(s, ikm);
    string out = "";
    string t = "";
    u8 counter = 1;
    usize want = length > 8160 ? 8160 : length;
    while (len(out) < want) {
        u8* c = __rt_alloc_bytes(1);
        c[0] = counter;
        t = hmac_sha256(prk, t . info . bytes_of(c, 1));
        out .= t;
        counter++;
    }
    return __rt_new_string(out->ptr, want);
}

// HKDF with SHA-512 (at most 16320 bytes).
function hkdf_sha512(string ikm, string salt, string info, usize length): string {
    string s = len(salt) > 0 ? salt : bytes_of(__rt_alloc_bytes(64), 64);
    string prk = hmac_sha512(s, ikm);
    string out = "";
    string t = "";
    u8 counter = 1;
    usize want = length > 16320 ? 16320 : length;
    while (len(out) < want) {
        u8* c = __rt_alloc_bytes(1);
        c[0] = counter;
        t = hmac_sha512(prk, t . info . bytes_of(c, 1));
        out .= t;
        counter++;
    }
    return __rt_new_string(out->ptr, want);
}

// --- PBKDF2 (RFC 8018) ---

// PBKDF2-HMAC-SHA-256. OWASP suggests 600000 iterations for passwords,
// but prefer std/password (Argon2id) for new password storage.
function pbkdf2_sha256(string password, string salt, int iterations, usize length): string {
    u32[8] inner;
    u32[8] outer;
    hmac256_state(password, &inner[0], &outer[0]);
    usize blocks = (length + 31) / 32;
    u8* out = __rt_alloc_bytes(blocks * 32 + 1);
    u8* first = alloc(u8, len(salt) + 4);
    defer free(first);
    __rt_copy(first, salt->ptr, len(salt));
    u8[32] u;
    u8[32] t;
    for (usize b = 0; b < blocks; b++) {
        u32 idx = (b + 1) as u32;
        first[len(salt)] = (idx >> 24) as u8;
        first[len(salt) + 1] = (idx >> 16) as u8;
        first[len(salt) + 2] = (idx >> 8) as u8;
        first[len(salt) + 3] = idx as u8;
        hmac256_with(&inner[0], &outer[0], first, len(salt) + 4, &u[0]);
        for (usize i = 0; i < 32; i++) {
            t[i] = u[i];
        }
        for (int it = 1; it < iterations; it++) {
            hmac256_with(&inner[0], &outer[0], &u[0], 32, &u[0]);
            for (usize j = 0; j < 32; j++) {
                t[j] = t[j] ^ u[j];
            }
        }
        __rt_copy(out + b * 32, &t[0], 32);
    }
    return bytes_of(out, length);
}

// PBKDF2-HMAC-SHA-512 (OWASP: 210000 iterations).
function pbkdf2_sha512(string password, string salt, int iterations, usize length): string {
    u64[8] inner;
    u64[8] outer;
    hmac512_state(password, &inner[0], &outer[0]);
    usize blocks = (length + 63) / 64;
    u8* out = __rt_alloc_bytes(blocks * 64 + 1);
    u8* first = alloc(u8, len(salt) + 4);
    defer free(first);
    __rt_copy(first, salt->ptr, len(salt));
    u8[64] u;
    u8[64] t;
    for (usize b = 0; b < blocks; b++) {
        u32 idx = (b + 1) as u32;
        first[len(salt)] = (idx >> 24) as u8;
        first[len(salt) + 1] = (idx >> 16) as u8;
        first[len(salt) + 2] = (idx >> 8) as u8;
        first[len(salt) + 3] = idx as u8;
        hmac512_with(&inner[0], &outer[0], first, len(salt) + 4, &u[0]);
        for (usize i = 0; i < 64; i++) {
            t[i] = u[i];
        }
        for (int it = 1; it < iterations; it++) {
            hmac512_with(&inner[0], &outer[0], &u[0], 64, &u[0]);
            for (usize j = 0; j < 64; j++) {
                t[j] = t[j] ^ u[j];
            }
        }
        __rt_copy(out + b * 64, &t[0], 64);
    }
    return bytes_of(out, length);
}
