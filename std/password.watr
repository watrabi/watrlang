private const string BCRYPT64 = "./ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789";

private class Blowfish {
    public u32* p;
    public u32* s;

    public function __construct() {
        this->p = alloc(u32, 18);
        this->s = alloc(u32, 1024);
        for (usize i = 0; i < 18; i++) {
            this->p[i] = BF_P[i];
        }
        for (usize j = 0; j < 1024; j++) {
            this->s[j] = BF_S[j];
        }
    }

    public function release() {
        free(this->p);
        free(this->s);
    }

    private function f(u32 x): u32 {
        u32* s = this->s;
        return ((s[(x >> 24) as usize] + s[256 + ((x >> 16) & 0xff) as usize]) ^ s[512 + ((x >> 8) & 0xff) as usize])
            + s[768 + (x & 0xff) as usize];
    }

    public function encipher(u32* l, u32* r) {
        u32 xl = *l;
        u32 xr = *r;
        for (usize i = 0; i < 16; i += 2) {
            xl = xl ^ this->p[i];
            xr = xr ^ this->f(xl);
            xr = xr ^ this->p[i + 1];
            xl = xl ^ this->f(xr);
        }
        xl = xl ^ this->p[16];
        xr = xr ^ this->p[17];
        *l = xr;
        *r = xl;
    }

    // The key schedule; with a salt it's bcrypt's salted variant.
    public function expand(string key, string salt) {
        usize kj = 0;
        for (usize i = 0; i < 18; i++) {
            this->p[i] = this->p[i] ^ stream_word(key, &kj);
        }
        usize sj = 0;
        u32 l = 0;
        u32 r = 0;
        for (usize i2 = 0; i2 < 18; i2 += 2) {
            if (len(salt) > 0) {
                l = l ^ stream_word(salt, &sj);
                r = r ^ stream_word(salt, &sj);
            }
            this->encipher(&l, &r);
            this->p[i2] = l;
            this->p[i2 + 1] = r;
        }
        for (usize k = 0; k < 1024; k += 2) {
            if (len(salt) > 0) {
                l = l ^ stream_word(salt, &sj);
                r = r ^ stream_word(salt, &sj);
            }
            this->encipher(&l, &r);
            this->s[k] = l;
            this->s[k + 1] = r;
        }
    }
}

private function stream_word(string data, usize* j): u32 {
    u32 w = 0;
    for (int i = 0; i < 4; i++) {
        w = (w << 8) | (data[*j] as u32);
        *j = (*j + 1) % len(data);
    }
    return w;
}

private function bcrypt64_encode(string data): string {
    string out = "";
    usize i = 0;
    while (i < len(data)) {
        u32 c1 = data[i] as u32;
        i++;
        out .= str::substr(BCRYPT64, (c1 >> 2) as usize, 1);
        c1 = (c1 & 3) << 4;
        if (i >= len(data)) {
            out .= str::substr(BCRYPT64, c1 as usize, 1);
            break;
        }
        u32 c2 = data[i] as u32;
        i++;
        c1 = c1 | (c2 >> 4);
        out .= str::substr(BCRYPT64, c1 as usize, 1);
        c1 = (c2 & 0x0f) << 2;
        if (i >= len(data)) {
            out .= str::substr(BCRYPT64, c1 as usize, 1);
            break;
        }
        c2 = data[i] as u32;
        i++;
        c1 = c1 | (c2 >> 6);
        out .= str::substr(BCRYPT64, c1 as usize, 1) . str::substr(BCRYPT64, (c2 & 0x3f) as usize, 1);
    }
    return out;
}

private function b64v(u8 c): int {
    int i = str::index_of(BCRYPT64, string { ptr: &c, len: 1 });
    return i;
}

// 16 salt bytes from bcrypt's 22-character salt; "" if malformed.
private function bcrypt64_salt(string s): string {
    if (len(s) != 22) {
        return "";
    }
    u8* out = __rt_alloc_bytes(18);
    usize o = 0;
    usize i = 0;
    while (o < 16) {
        int c1 = b64v(s[i]);
        int c2 = b64v(s[i + 1]);
        if (c1 < 0 || c2 < 0) {
            return "";
        }
        out[o] = ((c1 << 2) | ((c2 & 0x30) >> 4)) as u8;
        o++;
        if (o >= 16) {
            break;
        }
        int c3 = b64v(s[i + 2]);
        if (c3 < 0) {
            return "";
        }
        out[o] = (((c2 & 0x0f) << 4) | ((c3 & 0x3c) >> 2)) as u8;
        o++;
        int c4 = b64v(s[i + 3]);
        if (c4 < 0) {
            return "";
        }
        out[o] = (((c3 & 0x03) << 6) | c4) as u8;
        o++;
        i += 4;
    }
    return string { ptr: out, len: 16 };
}

// The 31-character bcrypt hash of password with a 16-byte salt.
private function bcrypt_core(string password, string salt, int cost): string {
    string key = password . "\x00";
    if (len(key) > 72) {
        key = str::substr(key, 0, 72);
    }
    Blowfish bf = new Blowfish();
    defer bf->release();
    bf->expand(key, salt);
    u64 rounds = 1 << (cost as u64);
    for (u64 r = 0; r < rounds; r++) {
        bf->expand(key, "");
        bf->expand(salt, "");
    }
    string magic = "OrpheanBeholderScryDoubt";
    u32[6] c;
    usize mj = 0;
    for (usize i = 0; i < 6; i++) {
        c[i] = stream_word(magic, &mj);
    }
    for (int n = 0; n < 64; n++) {
        bf->encipher(&c[0], &c[1]);
        bf->encipher(&c[2], &c[3]);
        bf->encipher(&c[4], &c[5]);
    }
    u8* out = __rt_alloc_bytes(24);
    for (usize k = 0; k < 6; k++) {
        out[k * 4] = (c[k] >> 24) as u8;
        out[k * 4 + 1] = (c[k] >> 16) as u8;
        out[k * 4 + 2] = (c[k] >> 8) as u8;
        out[k * 4 + 3] = c[k] as u8;
    }
    return bcrypt64_encode(string { ptr: out, len: 23 });
}

// A bcrypt hash ($2y$, as PHP's PASSWORD_BCRYPT makes) with cost 4-31.
// bcrypt only uses the first 72 bytes of a password and can't take NUL
// bytes; prefer password::hash (Argon2id) unless you need bcrypt.
function hash_bcrypt(string password, int cost): string {
    if (cost < 4 || cost > 31 || str::contains(password, "\x00")) {
        return "";
    }
    string salt = crypto::random_bytes(16);
    string encoded_salt = str::substr(bcrypt64_encode(salt), 0, 22);
    string two = cost < 10 ? "0{cost}" : "{cost}";
    return "$2y$" . two . "$" . encoded_salt . bcrypt_core(password, bcrypt64_salt(encoded_salt), cost);
}

private function verify_bcrypt(string password, string stored): bool {
    if (len(stored) != 60 || stored[0] != '$' || stored[1] != '2' || stored[3] != '$' || stored[6] != '$') {
        return false;
    }
    u8 variant = stored[2];
    if (variant != 'a' && variant != 'b' && variant != 'y') {
        return false;
    }
    int cost = str::to_int(str::substr(stored, 4, 2)) ?? 0;
    string salt = bcrypt64_salt(str::substr(stored, 7, 22));
    if (cost < 4 || cost > 31 || len(salt) != 16 || str::contains(password, "\x00")) {
        return false;
    }
    return crypto::equal(bcrypt_core(password, salt, cost), str::substr(stored, 29, 31));
}

// --- PBKDF2 formats ---

// passlib: $pbkdf2-sha256$ROUNDS$SALT$HASH in "adapted base64" ('.' for '+').
private function verify_passlib(string password, string stored): bool {
    vec::Vec<string> parts = str::split(stored, "$");
    if (parts->len() != 5) {
        return false;
    }
    int rounds = str::to_int(parts->get(2)) ?? 0;
    string salt = crypto::unbase64(str::replace(parts->get(3), ".", "+")) ?? "";
    string want = crypto::unbase64(str::replace(parts->get(4), ".", "+")) ?? "";
    if (rounds < 1 || rounds > 10000000 || len(want) == 0) {
        return false;
    }
    string got = "";
    if (parts->get(1) == "pbkdf2-sha256") {
        got = hash::pbkdf2_sha256(password, salt, rounds, len(want));
    } else if (parts->get(1) == "pbkdf2-sha512") {
        got = hash::pbkdf2_sha512(password, salt, rounds, len(want));
    } else {
        return false;
    }
    return crypto::equal(got, want);
}

// Django: pbkdf2_sha256$ROUNDS$SALT$BASE64HASH (the salt is used as text).
private function verify_django(string password, string stored): bool {
    vec::Vec<string> parts = str::split(stored, "$");
    if (parts->len() != 4 || parts->get(0) != "pbkdf2_sha256") {
        return false;
    }
    int rounds = str::to_int(parts->get(1)) ?? 0;
    string want = crypto::unbase64(parts->get(3)) ?? "";
    if (rounds < 1 || rounds > 10000000 || len(want) == 0) {
        return false;
    }
    return crypto::equal(hash::pbkdf2_sha256(password, parts->get(2), rounds, len(want)), want);
}

// --- the API ---

// Checks a password against any hash this module understands, in
// constant time. False for a wrong password or an unknown format.
function verify(string password, string stored): bool {
    if (len(password) > MAX_PASSWORD) {
        return false;
    }
    if (str::starts_with(stored, "$argon2")) {
        Argon2Hash a = parse_argon2(stored);
        if (!a->ok) {
            return false;
        }
        string got = argon2(a->kind, password, a->salt, a->t, a->m, a->p, len(a->digest), a->version);
        return len(got) > 0 && crypto::equal(got, a->digest);
    }
    if (str::starts_with(stored, "$2")) {
        return verify_bcrypt(password, stored);
    }
    if (str::starts_with(stored, "$pbkdf2-")) {
        return verify_passlib(password, stored);
    }
    if (str::starts_with(stored, "pbkdf2_sha256$")) {
        return verify_django(password, stored);
    }
    return false;
}

// True if `stored` isn't an Argon2id hash at least as strong as what
// password::hash makes today: after a successful login, hash the password
// again and save the new hash.
function needs_rehash(string stored): bool {
    if (!str::starts_with(stored, "$argon2id$")) {
        return true;
    }
    Argon2Hash a = parse_argon2(stored);
    return !a->ok || a->version != 0x13 || a->m < MEMORY_KIB || a->t < TIME_COST || len(a->digest) < 32 || len(a->salt) < 16;
}

