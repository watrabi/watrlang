// Password hashing, compatible with PHP's password_hash/password_verify:
//
//     import "std/password";
//     string stored = password::hash("correct horse");          // Argon2id
//     if (password::verify("correct horse", stored)) {
//         echo "welcome back\n";
//     }
//     if (password::needs_rehash(stored)) {
//         stored = password::hash("correct horse");   // then save it
//     }
//
// password::hash makes Argon2id hashes in the standard PHC format
// ($argon2id$v=19$m=...,t=...,p=...$salt$hash), the same strings PHP,
// libsodium, Python's argon2-cffi and others produce and accept.
// password::verify also accepts bcrypt ($2y$, $2b$, $2a$, as made by PHP's
// PASSWORD_BCRYPT and most frameworks) and PBKDF2 ($pbkdf2-sha256$ from
// passlib, pbkdf2_sha256$ from Django), so users can log in after moving
// from another system and be upgraded with needs_rehash.

import "std/hash";
import "std/crypto";
import "std/str";
import "std/vec";

// Argon2id cost: 19 MiB of memory and 2 passes, OWASP's recommended
// minimum. Raise MEMORY_KIB if logins can afford more time.
const int MEMORY_KIB = 19456;
const int TIME_COST = 2;
const int LANES = 1;
const int BCRYPT_COST = 12;

const int ARGON2D = 0;
const int ARGON2I = 1;
const int ARGON2ID = 2;

private const usize MAX_PASSWORD = 65536;

// --- Argon2 (RFC 9106) ---

private function le32(u64 v): string {
    u8* p = __rt_alloc_bytes(4);
    p[0] = v as u8;
    p[1] = (v >> 8) as u8;
    p[2] = (v >> 16) as u8;
    p[3] = (v >> 24) as u8;
    return string { ptr: p, len: 4 };
}

// H': BLAKE2b stretched to any output length.
private function hprime(string x, usize out_len): string {
    string input = le32(out_len as u64) . x;
    if (out_len <= 64) {
        return hash::blake2b(input, out_len, "");
    }
    usize r = (out_len + 31) / 32 - 2;
    string v = hash::blake2b(input, 64, "");
    u8* out = __rt_alloc_bytes(out_len);
    __rt_copy(out, v->ptr, 32);
    for (usize i = 1; i < r; i++) {
        v = hash::blake2b(v, 64, "");
        __rt_copy(out + i * 32, v->ptr, 32);
    }
    string last = hash::blake2b(v, out_len - 32 * r, "");
    __rt_copy(out + r * 32, last->ptr, out_len - 32 * r);
    return string { ptr: out, len: out_len };
}

private function rotr(u64 x, u64 n): u64 { return (x >> n) | (x << (64 - n)); }

private function blamka(u64 a, u64 b): u64 {
    return a + b + 2 * (a & 0xFFFFFFFF) * (b & 0xFFFFFFFF);
}

private function gb(u64* v, int a, int b, int c, int d) {
    v[a] = blamka(v[a], v[b]); v[d] = rotr(v[d] ^ v[a], 32);
    v[c] = blamka(v[c], v[d]); v[b] = rotr(v[b] ^ v[c], 24);
    v[a] = blamka(v[a], v[b]); v[d] = rotr(v[d] ^ v[a], 16);
    v[c] = blamka(v[c], v[d]); v[b] = rotr(v[b] ^ v[c], 63);
}

// The permutation P on 16 words of q picked by idx.
private function perm(u64* q, int* idx) {
    u64[16] v;
    for (usize i = 0; i < 16; i++) {
        v[i] = q[idx[i]];
    }
    gb(&v[0], 0, 4, 8, 12); gb(&v[0], 1, 5, 9, 13); gb(&v[0], 2, 6, 10, 14); gb(&v[0], 3, 7, 11, 15);
    gb(&v[0], 0, 5, 10, 15); gb(&v[0], 1, 6, 11, 12); gb(&v[0], 2, 7, 8, 13); gb(&v[0], 3, 4, 9, 14);
    for (usize j = 0; j < 16; j++) {
        q[idx[j]] = v[j];
    }
}

// next = G(prev, ref), XORed into next's old value when `xor_old`.
private function fill_block(u64* prev, u64* ref, u64* next, bool xor_old) {
    u64[128] r;
    u64[128] tmp;
    for (usize i = 0; i < 128; i++) {
        r[i] = prev[i] ^ ref[i];
        tmp[i] = xor_old ? r[i] ^ next[i] : r[i];
    }
    int[16] idx;
    for (int row = 0; row < 8; row++) {
        for (int k = 0; k < 16; k++) {
            idx[k] = row * 16 + k;
        }
        perm(&r[0], &idx[0]);
    }
    for (int col = 0; col < 8; col++) {
        for (int k2 = 0; k2 < 8; k2++) {
            idx[k2 * 2] = col * 2 + k2 * 16;
            idx[k2 * 2 + 1] = col * 2 + k2 * 16 + 1;
        }
        perm(&r[0], &idx[0]);
    }
    for (usize j = 0; j < 128; j++) {
        next[j] = tmp[j] ^ r[j];
    }
}

private function load_block(u64* dst, string bytes) {
    for (usize i = 0; i < 128; i++) {
        u64 v = 0;
        for (int b = 7; b >= 0; b--) {
            v = (v << 8) | (bytes[i * 8 + b as usize] as u64);
        }
        dst[i] = v;
    }
}

// Raw Argon2: `out_len` bytes from a password and salt (at least 8 bytes).
// kind is ARGON2ID (use this), ARGON2I or ARGON2D; t passes over
// m KiB of memory with p lanes. version is 0x13 (current) or 0x10.
// Returns "" for parameters out of range.
function argon2(int kind, string password, string salt, int t, int m, int p, usize out_len, int version): string {
    if (kind < 0 || kind > 2 || t < 1 || t > 1024 || p < 1 || p > 64 || m < 8 * p || m > 4194304
        || len(salt) < 8 || out_len < 4 || out_len > 1024 || (version != 0x13 && version != 0x10)) {
        return "";
    }
    string h0 = hash::blake2b(le32(p as u64) . le32(out_len as u64) . le32(m as u64) . le32(t as u64)
        . le32(version as u64) . le32(kind as u64) . le32(len(password) as u64) . password
        . le32(len(salt) as u64) . salt . le32(0) . le32(0), 64, "");
    int lane_len = (m / (4 * p)) * 4;
    int seg_len = lane_len / 4;
    int blocks = lane_len * p;
    u64* mem = alloc(u64, (blocks * 128) as usize);
    defer free(mem);
    for (int l = 0; l < p; l++) {
        load_block(mem + ((l * lane_len) * 128) as usize, hprime(h0 . le32(0) . le32(l as u64), 1024));
        load_block(mem + ((l * lane_len + 1) * 128) as usize, hprime(h0 . le32(1) . le32(l as u64), 1024));
    }
    u64[128] zero;
    u64[128] input;
    u64[128] addr;
    for (usize z = 0; z < 128; z++) {
        zero[z] = 0;
    }
    for (int pass = 0; pass < t; pass++) {
        for (int slice = 0; slice < 4; slice++) {
            for (int lane = 0; lane < p; lane++) {
                bool indep = kind == ARGON2I || (kind == ARGON2ID && pass == 0 && slice < 2);
                if (indep) {
                    for (usize q = 0; q < 128; q++) {
                        input[q] = 0;
                    }
                    input[0] = pass as u64;
                    input[1] = lane as u64;
                    input[2] = slice as u64;
                    input[3] = blocks as u64;
                    input[4] = t as u64;
                    input[5] = kind as u64;
                }
                int start = 0;
                if (pass == 0 && slice == 0) {
                    start = 2;
                    if (indep) {
                        input[6] = input[6] + 1;
                        fill_block(&zero[0], &input[0], &addr[0], false);
                        fill_block(&zero[0], &addr[0], &addr[0], false);
                    }
                }
                int cur = lane * lane_len + slice * seg_len + start;
                int prev = cur % lane_len == 0 ? cur + lane_len - 1 : cur - 1;
                for (int i = start; i < seg_len; i++) {
                    if (cur % lane_len == 1) {
                        prev = cur - 1;
                    }
                    u64 rnd = 0;
                    if (indep) {
                        if (i % 128 == 0) {
                            input[6] = input[6] + 1;
                            fill_block(&zero[0], &input[0], &addr[0], false);
                            fill_block(&zero[0], &addr[0], &addr[0], false);
                        }
                        rnd = addr[i % 128];
                    } else {
                        rnd = mem[(prev * 128) as usize];
                    }
                    int ref_lane = ((rnd >> 32) % (p as u64)) as int;
                    if (pass == 0 && slice == 0) {
                        ref_lane = lane;
                    }
                    bool same = ref_lane == lane;
                    i64 area = 0;
                    if (pass == 0) {
                        if (slice == 0) {
                            area = (i - 1) as i64;
                        } else if (same) {
                            area = (slice * seg_len + i - 1) as i64;
                        } else {
                            area = (slice * seg_len + (i == 0 ? -1 : 0)) as i64;
                        }
                    } else if (same) {
                        area = (lane_len - seg_len + i - 1) as i64;
                    } else {
                        area = (lane_len - seg_len + (i == 0 ? -1 : 0)) as i64;
                    }
                    u64 rel = rnd & 0xFFFFFFFF;
                    rel = (rel * rel) >> 32;
                    rel = (area as u64) - 1 - (((area as u64) * rel) >> 32);
                    u64 begin = 0;
                    if (pass != 0) {
                        begin = slice == 3 ? 0 : ((slice + 1) * seg_len) as u64;
                    }
                    int ref_index = ((begin + rel) % (lane_len as u64)) as int;
                    u64* refb = mem + ((ref_lane * lane_len + ref_index) * 128) as usize;
                    fill_block(mem + (prev * 128) as usize, refb, mem + (cur * 128) as usize, pass > 0 && version == 0x13);
                    cur++;
                    prev++;
                }
            }
        }
    }
    u64[128] final;
    for (usize f = 0; f < 128; f++) {
        final[f] = mem[((lane_len - 1) * 128) as usize + f];
    }
    for (int l2 = 1; l2 < p; l2++) {
        u64* last = mem + ((l2 * lane_len + lane_len - 1) * 128) as usize;
        for (usize f2 = 0; f2 < 128; f2++) {
            final[f2] = final[f2] ^ last[f2];
        }
    }
    u8* fb = __rt_alloc_bytes(1024);
    for (usize w = 0; w < 128; w++) {
        for (usize b = 0; b < 8; b++) {
            fb[w * 8 + b] = ((final[w] >> ((b * 8) as u64)) & 0xff) as u8;
        }
    }
    return hprime(string { ptr: fb, len: 1024 }, out_len);
}

private function b64_nopad(string data): string {
    string s = crypto::base64(data);
    while (str::ends_with(s, "=")) {
        s = str::substr(s, 0, len(s) - 1);
    }
    return s;
}

// An Argon2id hash with chosen costs (memory in KiB).
function hash_argon2id(string password, int memory_kib, int time_cost, int lanes): string {
    if (len(password) > MAX_PASSWORD) {
        return "";
    }
    string salt = crypto::random_bytes(16);
    string raw = argon2(ARGON2ID, password, salt, time_cost, memory_kib, lanes, 32, 0x13);
    if (len(raw) == 0) {
        return "";
    }
    return "$argon2id$v=19$m={memory_kib},t={time_cost},p={lanes}$" . b64_nopad(salt) . "$" . b64_nopad(raw);
}

// The recommended way to store a password: Argon2id with the costs above.
function hash(string password): string {
    return hash_argon2id(password, MEMORY_KIB, TIME_COST, LANES);
}

// A 32-byte encryption key from a password (Argon2id), for use with
// crypto::seal. Store the salt (16 random bytes) next to the data.
function derive_key(string password, string salt): string {
    return argon2(ARGON2ID, password, salt, TIME_COST, MEMORY_KIB, LANES, 32, 0x13);
}

// The parts of a $argon2...$ string (see parse_argon2).
class Argon2Hash {
    public bool ok = false;
    public int kind = 0;
    public int version = 0x10;
    public int m = 0;
    public int t = 0;
    public int p = 0;
    public string salt = "";
    public string digest = "";
}

private function param(string part, string key, int fallback): int {
    if (!str::starts_with(part, key . "=")) {
        return fallback;
    }
    return str::to_int(str::substr(part, len(key) + 1, len(part))) ?? -1;
}

// Splits a $argon2...$ string.
function parse_argon2(string stored): Argon2Hash {
    Argon2Hash a = new Argon2Hash();
    vec::Vec<string> parts = str::split(stored, "$");
    if (parts->len() < 5 || len(parts->get(0)) != 0) {
        return a;
    }
    string name = parts->get(1);
    if (name == "argon2id") {
        a->kind = ARGON2ID;
    } else if (name == "argon2i") {
        a->kind = ARGON2I;
    } else if (name == "argon2d") {
        a->kind = ARGON2D;
    } else {
        return a;
    }
    int at = 2;
    if (str::starts_with(parts->get(2), "v=")) {
        a->version = param(parts->get(2), "v", 16);
        if (a->version == 19) {
            a->version = 0x13;
        } else if (a->version == 16) {
            a->version = 0x10;
        } else {
            return a;
        }
        at = 3;
    }
    if (parts->len() != at + 3) {
        return a;
    }
    foreach (str::split(parts->get(at), ",") as kv) {
        a->m = param(kv, "m", a->m);
        a->t = param(kv, "t", a->t);
        a->p = param(kv, "p", a->p);
    }
    a->salt = crypto::unbase64(parts->get(at + 1)) ?? "";
    a->digest = crypto::unbase64(parts->get(at + 2)) ?? "";
    a->ok = len(a->salt) >= 8 && len(a->digest) >= 4 && a->m > 0 && a->t > 0 && a->p > 0
        && a->m <= 1048576 && a->t <= 64 && a->p <= 16;
    return a;
}

