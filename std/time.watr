// Clocks and sleeping, through Linux system calls.

import "std/sys";

private struct Timespec {
    i64 sec;
    i64 nsec;
}

private function clock(i64 which): i64 {
    Timespec ts;
    sys::syscall2(sys::CLOCK_GETTIME, which, (&ts) as i64);
    return ts->sec * 1000000000 + ts->nsec;
}

// Nanoseconds on a clock that only goes forward (for measuring).
function now_ns(): i64 { return clock(1); }

// Milliseconds since `start_ns` (a value from now_ns()).
function elapsed_ms(i64 start_ns): f64 { return (now_ns() - start_ns) as f64 / 1000000.0; }

// Seconds since 1970-01-01 UTC.
function unix(): i64 { return clock(0) / 1000000000; }

// Milliseconds since 1970-01-01 UTC.
function unix_ms(): i64 { return clock(0) / 1000000; }

function sleep_ns(i64 ns): void {
    Timespec ts = Timespec { sec: ns / 1000000000, nsec: ns % 1000000000 };
    sys::syscall2(sys::NANOSLEEP, (&ts) as i64, 0);
}

function sleep_ms(int ms): void { sleep_ns(ms * 1000000); }

// A civil date and time, UTC.
struct DateTime {
    int year;
    int month;    // 1-12
    int day;      // 1-31
    int hour;
    int minute;
    int second;
}

// Splits Unix time into a date (Howard Hinnant's days-to-civil algorithm).
function utc(i64 t): DateTime {
    i64 days = t / 86400;
    i64 secs = t % 86400;
    if (secs < 0) {
        secs += 86400;
        days -= 1;
    }
    i64 z = days + 719468;
    i64 era = (z >= 0 ? z : z - 146096) / 146097;
    i64 doe = z - era * 146097;
    i64 yoe = (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365;
    i64 doy = doe - (365 * yoe + yoe / 4 - yoe / 100);
    i64 mp = (5 * doy + 2) / 153;
    i64 d = doy - (153 * mp + 2) / 5 + 1;
    i64 m = mp < 10 ? mp + 3 : mp - 9;
    i64 y = yoe + era * 400 + (m <= 2 ? 1 : 0);
    return DateTime { year: y, month: m, day: d, hour: secs / 3600, minute: secs / 60 % 60, second: secs % 60 };
}

private function two(int x): string {
    return x < 10 ? "0{x}" : "{x}";
}

// "2026-10-13 14:05:09"
function format(DateTime d): string {
    return "{d->year}-{two(d->month)}-{two(d->day)} {two(d->hour)}:{two(d->minute)}:{two(d->second)}";
}
