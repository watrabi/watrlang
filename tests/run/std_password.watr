import "std/password";
import "std/crypto";

function main(): int {
    // libsodium's crypto_pwhash (Argon2id/Argon2i v1.3, one lane).
    echo crypto::hex(password::argon2(password::ARGON2ID, "password", "0123456789abcdef", 2, 8192, 1, 32, 0x13)), "\n";
    echo crypto::hex(password::argon2(password::ARGON2I, "password", "0123456789abcdef", 3, 8192, 1, 32, 0x13)), "\n";
    // The OpenBSD bcrypt vectors, as PHP's crypt() writes them.
    echo password::verify("U*U", "$2y$05$CCCCCCCCCCCCCCCCCCCCC.E5YPO9kmyuRGyh0XouQYb4YMJKvyOeW"), " ";
    echo password::verify("", "$2y$06$DCq7YPn5Rq63x1Lad4cll.TV4S6ytwfsfvkgY8jIucDrjc8deX1s."), " ";
    echo password::verify("U*V", "$2y$05$CCCCCCCCCCCCCCCCCCCCC.E5YPO9kmyuRGyh0XouQYb4YMJKvyOeW"), "\n";
    string h = password::hash_argon2id("hunter2", 1024, 2, 2);
    echo len(h) > 60, " ", password::verify("hunter2", h), " ", password::verify("hunter3", h), " ", password::needs_rehash(h), "\n";
    string b = password::hash_bcrypt("hunter2", 4);
    echo len(b), " ", password::verify("hunter2", b), " ", password::verify("Hunter2", b), " ", password::needs_rehash(b), "\n";
    echo password::verify("x", "plain text"), " ", password::verify("x", "$argon2id$v=19$m=1,t=1,p=1$c2FsdHNhbHQ$aGFzaA"), "\n";
    echo len(password::derive_key("correct horse", "0123456789abcdef")), "\n";
    return 0;
}
