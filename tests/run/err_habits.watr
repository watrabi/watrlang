// Habits from C, JavaScript and Python that watrlang rejects, with hints.
struct P { int x; }
class Box { public int v; public function get(): int { return this->v; } }
function main(): int {
    int n = 3;
    if (n) { echo "yes"; }
    string s = "a" + "b";
