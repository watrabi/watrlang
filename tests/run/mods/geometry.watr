// Imported by modules.watr.
import "sub/units";

struct Point {
    f64 x;
    f64 y;
}

const int SIDES = 4;
int calls = 0;

function area(f64 w, f64 h): f64 {
    calls++;
    return scale(w * h);
}

function origin(): Point {
    return Point { x: 0.0, y: 0.0 };
}

private function secret(): int {
    return 7;
}

function uses_secret(): int {
    return secret() * 6;
}

// Same name as a function in modules.watr: modules keep separate names.
function helper(): string {
    return "geometry helper";
}

enum Shape { Triangle = 3, Square, Pentagon }
private enum Hidden { Secret }

function sides(Shape s): int {
    return s as int;
}

class Circle {
    public f64 r;
    private f64 cached = -1.0;

    public function __construct(f64 r) {
        this->r = r;
    }

    public static function unit(): Circle {
        return new Circle(1.0);
    }

    public function area(): f64 {
        if (this->cached < 0.0) {
            this->cached = 3.0 * this->r * this->r;
        }
        return this->cached;
    }
}
