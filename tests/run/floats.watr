function hypot2(f64 x, f64 y): f64 {
    return x * x + y * y;
}

// Floats and ints mixed in the parameter list use separate registers.
function mix(int a, f64 b, int c, f32 d, f64 e, int f, f64 g, f64 h, f64 i, f64 j, f64 k, f64 l): f64 {
    return a as f64 + b + c as f64 + d + e + f as f64 + g + h + i + j + k + l;
}

function main(): int {
    f64 a = 1.5;
    f64 b = -a;
    f32 c = 2.5;
    c *= 2.0;                                   // 5.0
    f64 nan = 0.0 / 0.0;
    f64 inf = 1.0 / 0.0;
    bool ok = hypot2(3.0, 4.0) == 25.0 && b == -1.5 && c == 5.0
           && nan != nan && !(nan == nan) && !(nan < 1.0) && !(nan > 1.0)
           && inf > 1e308 && -inf < -1e308
           && 0.1 + 0.2 != 0.3 && 1.0 / 3.0 > 0.333
           && mix(1, 2.0, 3, 4.0, 5.0, 6, 7.0, 8.0, 9.0, 10.0, 11.0, 12.0) == 78.0;
    return ok as int;
}
