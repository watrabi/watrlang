// No return needed after a loop that can only exit through return.
function find(int target): int {
    int i = 0;
    while (true) {
        if (i * i >= target) return i;
        i++;
    }
}

function first_even(int start): int {
    for (int i = start; ; i++) {
        if (i % 2 == 0) return i;
    }
}

function main(): int {
    return (find(50) == 8) as int + (first_even(7) == 8) as int * 2;
}
