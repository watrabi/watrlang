// 8 parameters: the last two go on the stack (System V ABI).
function weigh(int a, int b, int c, int d, int e, int f, int g, int h): int {
    return a + 2*b + 3*c + 4*d + 5*e + 6*f + 7*g + 8*h;
}

function seven(int a, int b, int c, int d, int e, int f, int g): int {
    return g - a;
}

function main(): int {
    // Calls nested inside expressions leave pushes pending, which changes
    // stack alignment at the inner call.
    int x = 1 + weigh(1, 1, 1, 1, 1, 1, 1, 1);               // 37
    int y = weigh(8, 7, 6, 5, 4, 3, 2, 1) - 100;             // 20
    int z = seven(1, 2, 3, 4, 5, 6, weigh(0,0,0,0,0,0,0,1)); // 7
    return (x == 37) + (y == 20) * 2 + (z == 7) * 4;
}
