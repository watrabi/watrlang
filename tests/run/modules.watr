import "mods/geometry";
import "mods/land" as plot;
import "std/str";

function helper(): string {
    return "main helper";
}

class Disc extends geometry::Circle {
    public function area(): f64 {
        return parent::area() + 1.0;
    }
}

function main(): int {
    Point p = origin();
    geometry::Point q = geometry::Point { x: 3.0, y: 4.0 };
    echo "area: ", geometry::area(2.0, 3.0), " hectare: ", plot::area(1.0, 1.0), "\n";
    echo helper(), " / ", geometry::helper(), "\n";
    echo "sides: ", SIDES, ", calls: ", geometry::calls, ", secret: ", uses_secret(), "\n";
    echo "upper: ", to_upper("mods"), ", q.x: ", q->x, ", p.y: ", p->y, "\n";
    Shape sq = Shape::Square;
    geometry::Shape pent = geometry::Shape::Pentagon;
    echo "shapes: ", sq, " ", geometry::sides(pent), " ", pent, "\n";
    Circle c = new Circle(2.0);
    geometry::Circle u = geometry::Circle::unit();
    echo "circles: ", c->area(), " ", u->area(), " ", Circle::unit()->r, "\n";
    geometry::Circle d = new Disc(1.0);
    echo "disc: ", d->area(), " ", d instanceof Disc, "\n";
    return 0;
}
