function main(): int {
    int x = 6;
    x += 4;     // 10
    x -= 3;     // 7
    x *= 6;     // 42
    x /= 4;     // 10
    x %= 4;     // 2
    x <<= 4;    // 32
    x >>= 1;    // 16
    x |= 3;     // 19
    x &= 7;     // 3
    x ^= 1;     // 2

    int i = 5;
    int a = i++;   // a = 5, i = 6
    int b = ++i;   // b = 7, i = 7
    int c = i--;   // c = 7, i = 6
    int d = --i;   // d = 5, i = 5
    return (x == 2) + (a == 5) * 2 + (b == 7) * 4 + (c == 7) * 8 + (d == 5) * 16 + (i == 5) * 32;
}
