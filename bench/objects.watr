// Allocation-heavy: linked lists, strings and arrays (exercises the GC).
class Node {
    public int value;
    public Node next;
    public function __construct(int value, Node next) {
        this->value = value;
        this->next = next;
    }
}

function main(): int {
    int total = 0;
    for (int round = 0; round < 1000; round++) {
        Node head = null;
        for (int i = 0; i < 2000; i++) {
            head = new Node(i, head);
        }
        for (Node n = head; n != null; n = n->next) {
            total += n->value % 7;
        }
    }
    string s = "";
    for (int i = 0; i < 20000; i++) {
        s = "x" . i;
    }
    array a = [];
    for (int i = 0; i < 100000; i++) {
        a[i % 1000] = i;
    }
    echo total, " ", s, " ", len(a), "\n";
    return 0;
}
